# Datadog APM 배선 — 성능 고도화 2.5단계 (관측)
#
# Datadog 공식 `99datadog.config` + `99datadog-java-apm.config`를 합치고 세 군데를 고쳤다.
# 공식 파일을 그대로 쓰면 이 저장소에서는 깨지므로, 무엇을 왜 바꿨는지 아래에 남긴다.
#
#   ① JVM Options에 `-Duser.timezone=Asia/Seoul`을 유지했다 (공식 파일은 날려버린다)
#   ② api_key를 파일에 박지 않고 EB 환경 속성 DD_API_KEY에서 주입한다 (AGENTS.md §13)
#   ③ 힙을 512m → 2g로 올렸다 (인스턴스가 t4g.micro에서 m7g.large로 바뀐 뒤 방치돼 있었다)
#
# ⚠️ 이 파일은 WAR 안에 들어가야 EB가 읽는다. CD가 순수 WAR 하나만 올리기 때문이다.
#    build.gradle의 `war { from(...) }`이 그 일을 한다 — 둘 중 하나만 고치면 조용히 무시된다.

option_settings:
  aws:elasticbeanstalk:application:environment:
    DD_AGENT_MAJOR_VERSION: "7"
    # 트레이서가 이 값들로 Datadog에서 서비스를 묶는다.
    DD_SERVICE: "fitwallet-backend"
    DD_ENV: "prod"
    # 개선 전/후를 Datadog에서 갈라 보려면 이 값을 올린다.
    # 지금은 개선 전 기준선이므로 baseline이다.
    DD_VERSION: "baseline"
    DD_LOGS_INJECTION: "true"
    # DD_API_KEY는 여기 두지 않는다. 비밀값이라 EB 환경 속성에만 있다 (§13).

  aws:elasticbeanstalk:container:tomcat:jvmoptions:
    # ⚠️ `JVM Options`는 문자열 하나라 이 값이 기존 설정을 통째로 대체한다.
    # Datadog 공식 파일은 여기에 `-javaagent:...`만 적어서, 그대로 쓰면
    # `-Duser.timezone=Asia/Seoul`이 사라진다. AGENTS.md §10이 타임존을 KST로 못 박아
    # 두었고 DATETIME 처리 전체가 여기 걸려 있다 — 반드시 둘을 함께 적는다.
    JVM Options: "-Duser.timezone=Asia/Seoul -javaagent:/opt/dd-java-agent.jar"
    # t4g.micro(1 GiB) 시절 값이 m7g.large(8 GiB)로 올린 뒤에도 512m으로 남아 있었다.
    # 계획 문서 §6이 "앱이 병목이 되면 DB 개선 효과가 보이지 않는다"고 경계한 지점이라,
    # 부하 테스트 전에 올려 둔다. agent가 얹히면 더 빠듯해진다.
    Xms: "2g"
    Xmx: "2g"

files:
  # Java 트레이서. 요청·JDBC를 자동 계측해 span을 로컬 Agent(:8126)로 보낸다.
  "/opt/dd-java-agent.jar":
    mode: "000644"
    owner: root
    group: root
    source: https://dtdg.co/latest-java-tracer

  # Agent 설정. api_key는 자리표시자로 두고 container_command가 실제 값을 채운다.
  "/etc/datadog-agent/datadog.yaml":
    mode: "000640"
    owner: root
    group: root
    content: |
      api_key: PLACEHOLDER_REPLACED_AT_DEPLOY
      site: datadoghq.com
      apm_config:
        enabled: true

  "/opt/datadog_install_script.sh":
    mode: "000700"
    owner: root
    group: root
    source: https://install.datadoghq.com/scripts/install_script_agent7.sh

container_commands:
  01_inject_api_key:
    # EB 환경 속성은 배포 중 이 파일에 KEY=VALUE로 떨어진다. 여기서 읽어 설정에 박는다.
    # 키가 없으면 배포를 실패시킨다 — Agent가 조용히 안 뜨고 trace가 0건인 채로
    # "배선했는데 왜 안 보이지"를 반복하는 것보다 여기서 끊는 편이 낫다.
    command: |
      set -eu
      if [ -f /opt/elasticbeanstalk/deployment/env ]; then
        set -a
        . /opt/elasticbeanstalk/deployment/env
        set +a
      fi
      if [ -z "${DD_API_KEY:-}" ]; then
        echo "DD_API_KEY가 비어 있다. EB 환경 속성에 넣어야 한다:" >&2
        echo "  aws elasticbeanstalk update-environment --environment-name fitwallet-prod \\" >&2
        echo "    --option-settings Namespace=aws:elasticbeanstalk:application:environment,OptionName=DD_API_KEY,Value=<키>" >&2
        exit 1
      fi
      sed -i "s|^api_key:.*|api_key: ${DD_API_KEY}|" /etc/datadog-agent/datadog.yaml

  02_install_agent:
    # 설치 스크립트는 datadog.yaml이 이미 있으면 덮어쓰지 않는다.
    # 그래서 DD_API_KEY에 더미를 넘겨 위에서 박은 실제 키를 지키게 한다 (공식 파일과 같은 방식).
    command: |
      set -eu
      DD_API_KEY="dummy" DD_INSTALL_ONLY="true" bash /opt/datadog_install_script.sh

  03_restart_agent:
    # 위에서 키를 바꿨으므로 Agent가 새 설정을 읽게 한다.
    command: |
      set -eu
      systemctl enable datadog-agent
      systemctl restart datadog-agent
