# 이 파일을 .env 로 복사한 뒤 사용하세요.
# cp .env.sample .env
#
# docker-compose.yml이 이 값들로 로컬 MySQL 컨테이너를 만듭니다.
# 로컬 개발 전용 값이며 운영 비밀정보가 아니므로 팀 전체가 동일한 값을 그대로 사용해도 됩니다.
# src/main/resources/db.properties.sample과 계정/DB명이 짝이 맞아야 합니다.

MYSQL_ROOT_PASSWORD=root1234
MYSQL_DATABASE=fitwallet
MYSQL_USER=fitwallet
MYSQL_PASSWORD=fitwallet1234
MYSQL_PORT=3306
