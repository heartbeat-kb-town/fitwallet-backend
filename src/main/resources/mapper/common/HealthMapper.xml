<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fitwallet.global.common.mapper.HealthMapper">

    <select id="findLatest" resultType="com.fitwallet.global.common.HealthCheck">
        SELECT id, message, checked_at AS checkedAt
        FROM health_check
        ORDER BY id DESC
        LIMIT 1
    </select>

</mapper>
