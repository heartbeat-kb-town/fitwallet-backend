<?xml version="1.0" encoding="UTF-8"?>
<beans:beans xmlns="http://www.springframework.org/schema/mvc"
             xmlns:beans="http://www.springframework.org/schema/beans"
             xmlns:context="http://www.springframework.org/schema/context"
             xmlns:util="http://www.springframework.org/schema/util"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.springframework.org/schema/mvc
                                  http://www.springframework.org/schema/mvc/spring-mvc.xsd
                                  http://www.springframework.org/schema/beans
                                  http://www.springframework.org/schema/beans/spring-beans.xsd
                                  http://www.springframework.org/schema/context
                                  http://www.springframework.org/schema/context/spring-context.xsd
                                  http://www.springframework.org/schema/util
                                  http://www.springframework.org/schema/util/spring-util.xsd">

    <annotation-driven>
        <message-converters>
            <beans:bean class="org.springframework.http.converter.json.MappingJackson2HttpMessageConverter">
                <beans:property name="objectMapper" ref="objectMapper"/>
            </beans:bean>
        </message-converters>
        <argument-resolvers>
            <beans:bean class="com.fitwallet.global.config.LoginUserIdArgumentResolver"/>
        </argument-resolvers>
    </annotation-driven>

    <!--
        인증 컨텍스트 전달 통로.
        컨트롤러는 @LoginUserId 로만 사용자를 받고, 헤더/세션을 직접 읽지 않는다.
        AuthInterceptor가 Authorization: Bearer {Access Token}을 검증해 사용자 식별자를 꺼낸다.
    -->
    <interceptors>
        <interceptor>
            <mapping path="/api/**"/>
            <exclude-mapping path="/api/user/signup"/>
            <exclude-mapping path="/api/user/login"/>
            <exclude-mapping path="/api/user/reissue"/>
            <beans:bean class="com.fitwallet.global.config.AuthInterceptor" autowire="constructor"/>
        </interceptor>
    </interceptors>

    <beans:bean id="objectMapper" class="org.springframework.http.converter.json.Jackson2ObjectMapperFactoryBean">
        <beans:property name="findModulesViaServiceLoader" value="true"/>
        <beans:property name="featuresToDisable">
            <beans:array>
                <util:constant static-field="com.fasterxml.jackson.databind.SerializationFeature.WRITE_DATES_AS_TIMESTAMPS"/>
            </beans:array>
        </beans:property>
    </beans:bean>

    <resources mapping="/images/**" location="/resources/images/"/>

    <!--
        Swagger(OpenAPI) 문서 설정.

        springfox는 RequestMappingHandlerMapping을 읽어 문서를 만들므로 그 빈이 있는 이 웹 컨텍스트에
        있어야 한다. 그런데 아래 component-scan이 use-default-filters="false"라 @Configuration을
        스캔으로는 못 잡는다 — 그래서 명시적으로 등록한다.
        (반대로 root-context.xml은 기본 필터라 잡아버리므로 그쪽엔 exclude-filter를 걸어뒀다)
    -->
    <beans:bean class="com.fitwallet.global.config.SwaggerConfig"/>

    <!--
        Swagger UI 정적 리소스. Boot라면 자동 등록되지만 이 스택은 아니라서 직접 매핑해야 한다.
        빠뜨리면 /v3/api-docs는 JSON을 잘 내려주는데 UI만 404가 난다.
    -->
    <resources mapping="/swagger-ui/**" location="classpath:/META-INF/resources/webjars/springfox-swagger-ui/"/>
    <resources mapping="/webjars/**" location="classpath:/META-INF/resources/webjars/"/>

    <!--
        @ControllerAdvice는 @Controller가 아니라 @Component 계열이라
        include 필터에 따로 넣지 않으면 GlobalExceptionHandler가 등록되지 않는다.
        (등록 실패해도 예외가 나지 않고 모든 오류가 조용히 500으로 떨어진다)
    -->
    <context:component-scan base-package="com.fitwallet" use-default-filters="false">
        <context:include-filter type="annotation"
                                expression="org.springframework.stereotype.Controller"/>
        <context:include-filter type="annotation"
                                expression="org.springframework.web.bind.annotation.ControllerAdvice"/>
    </context:component-scan>

</beans:beans>
